# Local development: npm ci && npm run dev (Node.js 24+).
# The server reads this file automatically. Do not commit it.
# npm workspace dev runs the server from packages/server, so ./data is relative
# to that directory. Use an absolute DATA_DIR when reusing an existing database.
PORT=8787
HOST=0.0.0.0
CLIENT_DIR=
DATA_DIR=./data
ALLOWED_ORIGINS=
TRUST_PROXY=0
LOG_LEVEL=info

# Production via docker compose. Set a real domain without https:// or a path.
# Point its DNS to the server first. Compose sets production/cookies/HTTPS proxy.
DOMAIN=
MAX_ROOMS=100

# Optional AI referee. Server-side only; never put keys in VITE_* variables.
# With no key, ranked play uses camera-verifiable prompts. Friendly play can
# still use peer votes. With AI, each round uses two separately validated passes.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Optional private local detector service. Not needed for normal deployment.
YOLO_URL=
YOLO_TOKEN=

# Legacy guest identity signing. Normally generated as DATA_DIR/identity.key.
# Preserve that file when importing old profiles; accounts use separate sessions.
IDENTITY_SECRET=

CLIENT_PORT=5173
SERVER_PORT=8787
