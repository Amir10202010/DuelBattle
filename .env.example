# Local development: npm ci && npm run dev (Node.js 24+).
# The server reads this file automatically. Do not commit it.
# npm workspace dev runs the server from packages/server, so ./data is relative
# to that directory. Use an absolute DATA_DIR when reusing an existing database.
# The port in production. In development SERVER_PORT wins; see the pair at the
# bottom of this file.
PORT=8787
HOST=0.0.0.0
CLIENT_DIR=
DATA_DIR=./data
ALLOWED_ORIGINS=
TRUST_PROXY=0
LOG_LEVEL=info

# Sign-in. Secrets stay on the server. See docs/ACCOUNTS-AND-ITEMS.md.
# Production: use the public HTTPS origin with no trailing slash.
APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who carries the verification code. Set one key and MAIL_FROM; with neither,
# development shows the code in the form instead of sending it.
# RESEND needs a domain you own, verified with DNS records.
# BREVO verifies a single sender address, so it works without a domain.
# Both set: Resend wins.
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=

# Production via docker compose. Set a real domain without https:// or a path.
# Point its DNS to the server first. Compose sets production/cookies/HTTPS proxy.
DOMAIN=
MAX_ROOMS=100

# Optional AI referee. Server-side only; never put keys in VITE_* variables.
# With no key, play uses camera-verifiable prompts.
# With AI, each round uses two separately validated passes.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Optional private local detector service. Not needed for normal deployment.
YOLO_URL=
YOLO_TOKEN=

# Legacy guest identity signing. Normally generated as DATA_DIR/identity.key.
# Preserve that file when importing old profiles; accounts use separate sessions.
IDENTITY_SECRET=

# Optional Telegram bot and Mini App. With no token none of it is constructed:
# no routes, no timers, no change to the game. Setup: docs/telegram.md.
# The token is server-side only; never put it in a VITE_* variable.
TELEGRAM_BOT_TOKEN=
# Without the @. Every t.me link the product hands out is built from it.
TELEGRAM_BOT_USERNAME=
# Your public HTTPS origin, no trailing slash. Falls back to APP_ORIGIN.
TELEGRAM_MINI_APP_URL=
# A long random string Telegram echoes back on every webhook delivery.
# Without it the webhook is not registered and the endpoint answers 404.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram user ids, comma separated. Usernames are not identities.
TELEGRAM_ADMIN_IDS=
TELEGRAM_SUPPORT_CHAT_ID=
# Set to 0 to switch the integration off without removing the token.
TELEGRAM_BOT_ENABLED=1

# Telegram Stars pricing. Days 0 means a purchase never expires.
TELEGRAM_PREMIUM_STARS=250
TELEGRAM_PREMIUM_DAYS=30
# Battle coins paid when an invited player finishes their first real match.
TELEGRAM_REFERRAL_REWARD=150
TELEGRAM_REFERRAL_WELCOME=75

# The development pair. Vite listens on CLIENT_PORT and proxies /api and /ws to
# SERVER_PORT, and in development the server listens on SERVER_PORT too, so the
# two halves cannot drift apart whatever PORT the surrounding environment
# carries. In production SERVER_PORT is ignored and PORT alone decides.
CLIENT_PORT=5173
SERVER_PORT=8787
