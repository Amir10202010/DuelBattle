PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/duelbattle.sqlite
# Production requires HTTPS and NODE_ENV=production. The production start command sets it internally.
# Set only if exactly one trusted reverse proxy sits in front of the app.
TRUST_PROXY=0
# Optional TURN relay for players on restrictive networks. Use a coturn REST shared secret.
TURN_URLS=
TURN_SECRET=
STUN_URL=stun:stun.cloudflare.com:3478

# Gemini AI judge. Keys stay on the server. Comma-separated keys; keep your Google projects on Free Tier.
# Keys belonging to the same Google project SHARE quotas. At most 3 keys are tried per round.
GEMINI_API_KEYS=
# A single GEMINI_API_KEY also works if GEMINI_API_KEYS is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local YOLOv8 service (start with npm run yolo). Gemini can assess photos if YOLO is unavailable.
YOLO_URL=http://127.0.0.1:8001
YOLO_SERVICE_TOKEN=
# Optional Python interpreter/model overrides:
# YOLO_PYTHON=.venv-yolo/Scripts/python.exe
# YOLO_MODEL=vision/models/yolov8n.pt
