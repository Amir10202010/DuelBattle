# Server ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Serve the built client from the game server (single-service deployment).
# Leave empty in development; Vite serves the client and proxies to this one.
CLIENT_DIR=
# Comma-separated origins allowed to open a WebSocket. Empty means same-origin
# only, which is what you want when CLIENT_DIR is set.
ALLOWED_ORIGINS=
# Set to 1 only when running behind a proxy you control, so X-Forwarded-For can
# be trusted for per-IP connection limits.
TRUST_PROXY=0
# How long a socket may stay open without joining a room. The client connects on
# page load, so this is also how long someone may read the landing page.
IDLE_SOCKET_TTL_MS=600000
LOG_LEVEL=info

# AI referee (optional) -------------------------------------------------
# With no keys the game plays exactly as it does today: the twelve prompts a
# referee would decide stay with the opponent. Comma-separated; they are
# rotated, and one that hits its quota rests while the others carry on.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Optional local YOLO service. Its detections are hints handed to the referee
# alongside the photographs; they never award a point on their own.
YOLO_URL=
YOLO_TOKEN=

# Client dev server ----------------------------------------------------
CLIENT_PORT=5173
SERVER_PORT=8787
